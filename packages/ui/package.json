{
  "name": "@dovli/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dovli's web UI kit: buttons, menus, dialogs, icons and the Tailwind theme mapping. Every component reads the active app theme.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dovli/config": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  }
}
