{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_UNFURL_ENDPOINT",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "ANTHROPIC_API_KEY",
    "AI_MODEL",
    "AI_MONTHLY_TOKENS",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {},
    "clean": {
      "cache": false
    },
    "@dovli/desktop#build": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../web/src/**",
        "../web/public/**",
        "../web/.env*",
        "../../packages/*/src/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
