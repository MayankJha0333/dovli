rules_version = '2';

// Dovli's Firestore. Today only the server uses it (Admin SDK, which skips these rules):
//   authEmailCodes/*  sign-in code hashes, tries and send history
//   authRateLimits/*  per-network send counts
//   aiUsage/*         each account's monthly AI use
// The app itself may read and write nothing yet. Page sync will add rules for users/{uid}/...
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
