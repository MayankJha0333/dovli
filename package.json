{
  "name": "dovli",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@dovli/web",
    "dev:mobile": "pnpm --filter @dovli/mobile start",
    "mobile": "pnpm --filter @dovli/mobile start --clear",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test": "turbo run test",
    "emulators": "npx firebase-tools@15.34.0 emulators:start --project demo-dovli",
    "deploy:rules": "npx firebase-tools@15.34.0 deploy --only firestore:rules"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
