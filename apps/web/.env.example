# Copy this file to .env.local and fill in what you use. Everything is optional:
# with nothing set, Dovli runs fully on this device (no sign-in, no AI).

# ---------- Sign-in (Firebase Authentication) ----------
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and config.
# These six are safe in the browser (they only say which project to use).
# Setting them turns on the sign-in gate: the app then needs an account (see README), so set
# FIREBASE_SERVICE_ACCOUNT below too, or nobody can get in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server only, never sent to the browser. Firebase console → Project settings → Service accounts
# → Generate new private key. Paste the whole JSON on one line, or base64-encode it. Keep it secret.
FIREBASE_SERVICE_ACCOUNT=

# Server only. A long random string that seals the email sign-in codes (32+ characters).
# Make one with:  openssl rand -base64 48
AUTH_CODE_SECRET=

# Server only. Sends the sign-in code emails through any SMTP service (Gmail app password,
# Resend, SendGrid, Amazon SES, Brevo…). Either one SMTP_URL, or the four SMTP_* parts.
# Without SMTP in development, the code is printed in the terminal running `pnpm dev`.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com and
# SMTP_PASS=a 16-letter app password from https://myaccount.google.com/apppasswords
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dovli <hello@yourdomain.com>

# Optional, for local testing with the Firebase emulators (`pnpm emulators`):
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---------- AI writing help (Anthropic) ----------
# Server only. Without it the AI buttons explain that AI isn't set up.
ANTHROPIC_API_KEY=
# Optional. The model to use, and how many tokens each person gets per month.
AI_MODEL=claude-haiku-5-5
AI_MONTHLY_TOKENS=200000

# ---------- Link previews ----------
# Optional: your own link-preview server. It must return JSON shaped like microlink:
# { "data": { "title": "", "description": "", "publisher": "", "image": { "url": "" }, "logo": { "url": "" } } }
# The link is appended URL-encoded, so end the address with ?url=
# Without it, previews use microlink.io.
NEXT_PUBLIC_UNFURL_ENDPOINT=
