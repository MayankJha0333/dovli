# Copy this file to .env.local and fill in what you use. Everything is optional:
# with nothing set, Dovli runs fully on this device (no sign-in, no sync, no AI).

# ---------- Cloud sync, sign-in and share links (Supabase) ----------
# Supabase dashboard → Project Settings → API. The anon key is safe in the browser;
# row-level security in supabase/migrations keeps each person's pages private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never sent to the browser. Used to delete an account, to serve files on
# shared pages, and to count AI use. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI writing help (Anthropic) ----------
# Server only. Without it the AI buttons explain that AI isn't set up.
ANTHROPIC_API_KEY=
# Optional. The model to use, and how many tokens each person gets per month.
AI_MODEL=claude-haiku-5-5
AI_MONTHLY_TOKENS=200000

# ---------- Link previews ----------
# Optional: your own link-preview server. It must return JSON shaped like microlink:
# { "data": { "title": "", "description": "", "publisher": "", "image": { "url": "" }, "logo": { "url": "" } } }
# The link is appended URL-encoded, so end the address with ?url=
# Without it, previews use microlink.io.
NEXT_PUBLIC_UNFURL_ENDPOINT=
