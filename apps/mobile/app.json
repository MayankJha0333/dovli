{
  "expo": {
    "name": "Dovli",
    "slug": "dovli",
    "owner": "luffylabs-team",
    "scheme": "dovli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dovli"
    },
    "android": {
      "package": "app.dovli",
      "adaptiveIcon": {
        "backgroundColor": "#FBFAFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EDEFF4",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#08090B"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "18381e67-e259-4c6b-8814-c41ded9f1fd6"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/18381e67-e259-4c6b-8814-c41ded9f1fd6"
    }
  }
}
