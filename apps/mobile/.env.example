# Copy this file to .env and fill it in to turn on sign-in in the phone app.
# Use the same Firebase project as the web app (the same web-app config values work here).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Dovli's server: sign-in codes, sync and account. https://dovli.in is the live one.
# To test against your own computer instead (pnpm dev), use http://localhost:3000 in the Simulator,
# or your computer's network address on a real phone (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=https://dovli.in

# Optional, for local testing with the Firebase emulators:
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Google sign-in on the phone (Firebase console → Authentication → Sign-in method → Google, and
# Project settings → Your apps → the iOS app "app.dovli"). Rebuild the app after changing these.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
