{
  "manifest_version": 3,
  "name": "Dovli – Web Clipper & Notes",
  "short_name": "Dovli",
  "version": "0.3.0",
  "description": "Clip web pages to Dovli, make AI notes from them, and write in a Dovli page beside any website.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Dovli: clip this page or open your notes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://dovli.in/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the Dovli popup"
    },
    "open-drawer": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Dovli notes drawer beside this page"
    }
  }
}
