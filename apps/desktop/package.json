{
  "name": "@dovli/desktop",
  "productName": "Dovli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dovli for Mac and Windows",
  "author": "Dovli",
  "homepage": "https://dovli.in",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --configLoader runner && vite build -c vite.main.config.ts --mode main && vite build -c vite.main.config.ts --mode preload",
    "start": "electron .",
    "pack:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "fonts": "node scripts/fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist release .turbo"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@dovli/config": "workspace:*",
    "@dovli/core": "workspace:*",
    "@dovli/editor": "workspace:*",
    "@dovli/sync": "workspace:*",
    "@dovli/theme": "workspace:*",
    "@dovli/ui": "workspace:*",
    "@dovli/web": "workspace:*",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
