# ---------- Dependencies ----------
node_modules/
.pnpm-store/

# ---------- Turborepo ----------
.turbo/

# ---------- Next.js (apps/web) ----------
.next/
out/
next-env.d.ts
.vercel/

# ---------- Expo / React Native (apps/mobile) ----------
.expo/
expo-env.d.ts
web-build/
dist/
.metro-health-check*
*.orig.*
# Native projects are generated by `expo prebuild`, so they are not committed.
# Delete these two lines if you ever start editing the native code by hand.
apps/mobile/ios/
apps/mobile/android/

# App-signing files: never commit these.
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ---------- Builds and tooling ----------
build/
coverage/
*.tsbuildinfo
dist-single/

# ---------- Environment files ----------
# Real secrets stay on your machine; the .env.example files are committed.
.env
.env.*
!.env.example

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS and editors ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
